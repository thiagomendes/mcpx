# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcpx

# Redis
REDIS_URL=redis://localhost:6379

# JWT (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-at-least-32-characters

# Frontend
FRONTEND_URL=http://localhost:3000

# Backend
BACKEND_PORT=8080
RUST_LOG=info

# Data Retention (TimescaleDB policies - global, not per-org)
RETENTION_METRICS_DAYS=7
RETENTION_REQUEST_LOGS_DAYS=7
RETENTION_AUDIT_LOGS_DAYS=90
RETENTION_AUDIT_EVENTS_DAYS=90

# System Intervals (global, not per-org)
HEALTH_CHECK_INTERVAL_SECONDS=300
ALERT_EVAL_INTERVAL_SECONDS=60
SESSION_CACHE_HOURS=1
