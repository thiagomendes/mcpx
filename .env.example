# =============================================================================
# mcpx Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# For Docker Compose, most values have defaults. Only OAuth credentials are required.

# =============================================================================
# OAuth Providers (at least one is required)
# =============================================================================

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft OAuth (https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# =============================================================================
# Security
# =============================================================================

# JWT secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-at-least-32-characters

# AES encryption key for credentials (optional, defaults to JWT_SECRET)
# ENCRYPTION_KEY=your-encryption-key

# =============================================================================
# URLs (optional, have sensible defaults)
# =============================================================================

# Frontend URL for CORS and redirects
# FRONTEND_URL=http://localhost:3000

# Backend URL for OAuth callbacks
# BASE_URL=http://localhost:8080

# =============================================================================
# Database (optional for Docker Compose, required for standalone)
# =============================================================================

# PostgreSQL connection string (Docker Compose sets this automatically)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcpx

# =============================================================================
# Logging
# =============================================================================

# Log level: trace, debug, info, warn, error
# RUST_LOG=info
