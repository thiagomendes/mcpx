### MCPX API Testing - Complete Endpoint Coverage
### Replace tokens below before running

@baseUrl = http://localhost:8080

### ========================================
### TOKENS - Fill these in before testing
### ========================================

# M2M Admin Token (get via /api/auth/token)
@m2m_admin = YOUR_M2M_ADMIN_JWT_HERE

# M2M Member Token (get via /api/auth/token)
@m2m_member = YOUR_M2M_MEMBER_JWT_HERE

# PAT Owner
@pat_owner = mcpx_pat_EzVBLfdJxiPsvSX7DZelTpwnUwc0MpM1

# PAT Admin
@pat_admin = mcpx_pat_u6uUJtie9dYFfOCKGpyEFMvZtW7xxHBx

# PAT Member
@pat_member = mcpx_pat_xinfeb3sZDK6GR0qdkb1X2LbOam58Cm8

### ========================================
### GET M2M TOKENS (run these first)
### ========================================

### Get M2M Admin Token
# @name getM2MAdmin
POST {{baseUrl}}/api/auth/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=mcpx_sa_LjZeLB1w3L7ysslG0nIJqOSK0kXIZS1u&client_secret=mcpx_secret_gNRv8IYcdhPaYs4bcoxi1yVFvGLKaGjf1NDoiMyRaNSNQ182

###

### Get M2M Member Token
# @name getM2MMember
POST {{baseUrl}}/api/auth/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=mcpx_sa_6B4RUdnDeKIdeOQvM4sb9XBW21w9Wvjc&client_secret=mcpx_secret_4LhQr78zuszHnPWbFa1zdlCDP3TUI3hBg3CaKnsFKthvrDx4

